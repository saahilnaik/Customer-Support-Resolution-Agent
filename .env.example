# Free key from https://console.groq.com
GROQ_API_KEY=your_key_here
# Must be a model your key can use; list them with the command in README "Troubleshooting"
GROQ_MODEL=openai/gpt-oss-120b
REFUND_APPROVAL_THRESHOLD=50
# fastembed (local model, auto-falls back to tfidf) | tfidf
EMBEDDING_BACKEND=fastembed
EXTERNAL_API_BASE_URL=http://127.0.0.1:8000/mock
# Seeds public demo API keys (demo-key-alice, demo-key-reviewer, ...). Set false anywhere real
# and create keys with: python -m app.auth create-key --role reviewer --name "<name>"
SEED_DEMO_KEYS=true
